# Background
background = #060606
background-opacity = 0.90

# Theme
theme = GitHub Dark

# Font
font-size = 14
font-family = JetBrainsMono Nerd Font

# Misc
#foreground = #c2cbf1
#selection-background = #46485d

# GTK (Linux)
gtk-titlebar = false

# ── macOS-style copy/paste ───────────────────────────────────────────────────
# keyd remaps ⌘ → Ctrl and ⌃ → Super, so the physical ⌘ key arrives here as
# ctrl. Make ⌘+C copy and ⌘+V paste, and keep interrupt (^C) on ⌃ (super).
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = super+c=text:\x03
keybind = super+v=text:\x16

# Window
window-height = 45
window-width = 180
window-position-x = 180
window-position-y = 180
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = never
window-new-tab-position = current

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Cursor
#cursor-color = #f2d8d4
cursor-style = bar
cursor-style-blink = false

# Custom Shader
custom-shader = shaders/ghostty/cursor_warp.glsl
