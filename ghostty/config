# Background
background = #060606
background-opacity = 0.90

# Theme
theme = GitHub Dark

# Font
font-size = 14
font-family = JetBrainsMono Nerd Font

# Misc
#foreground = #c2cbf1
#selection-background = #46485d

# GTK (Linux)
gtk-titlebar = false

# ── macOS-style copy/paste/interrupt ─────────────────────────────────────────
# keyd remaps ⌘ → Ctrl and ⌃ → Super. The physical ⌘ arrives as ctrl, and the
# physical ⌃ sends ctrl+alt+c / ctrl+alt+v (keyd moves ⌃+C/V off Super, which
# Cinnamon grabs globally). So: ⌘+C copy, ⌘+V paste, ⌘+Q quit, ⌃+C interrupt.
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+q=quit
keybind = ctrl+alt+c=text:\x03
keybind = ctrl+alt+v=text:\x16

# Window
window-height = 45
window-width = 180
window-position-x = 180
window-position-y = 180
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = never
window-new-tab-position = current

# Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Cursor
#cursor-color = #f2d8d4
cursor-style = bar
cursor-style-blink = false

# Custom Shader
custom-shader = shaders/ghostty/cursor_warp.glsl
